<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_container"
    android:layout_height="150dp"
    android:layout_width="match_parent"
    android:elevation="3dp"
    app:cardCornerRadius="11dp" >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.example.projectwork_1.view.customviews.RatingDonutView
            android:id="@+id/rating_donut"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:translationZ="11dp"
            app:stroke="9"
            app:progress="77"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/poster"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@tools:sample/avatars"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/poster"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textAlignment="center"
            android:text="Title"
            android:padding="8dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Headline" />

        <TextView
            android:id="@+id/remind_time_tv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toEndOf="@id/poster"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/button_refactor"
            tools:text="23:45:43 34.24.56"
            android:textColor="@color/black"
            android:layout_marginStart="8dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/button_refactor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/poster"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="Refactor"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/remind_time_tv"
            android:layout_marginTop="8dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.2"
            style="@style/StyleForWatchLaterButtons" />

        <Button
            android:id="@+id/button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/button_refactor"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="Cancel"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/remind_time_tv"
            android:layout_marginTop="8dp"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.2"
            style="@style/StyleForWatchLaterButtons" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
