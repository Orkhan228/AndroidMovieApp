<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ProjectWork_1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimary">#FF004D</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="android:statusBarColor">@color/red</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="fragmentBackgroundSettings">@drawable/fon_for_settings_fragment</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="fragmentBackgroundHome">@drawable/grad_rect</item>
    </style>

    <style name="Theme.ProjectWork_1" parent="Base.Theme.ProjectWork_1" />

    <style name="Bottom_view" parent="ThemeOverlay.MaterialComponents">
        <item name="android:background">@color/colorPrimary</item>
    </style>

    <style name="ThemeForSplashScreen" parent="Base.Theme.ProjectWork_1">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    
    <style name="ToolBarTitleShadow" parent="TextAppearance.AppCompat.Large">
        <item name="android:textSize">38sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">@color/black</item>
        <item name="android:shadowDx">24</item>
        <item name="android:shadowDy">24</item>
        <item name="android:shadowRadius">28</item>
    </style>

    <style name="SearchViewStyle">
        <item name="colorControlNormal">#000000</item>   <!-- Цвет иконок -->
        <item name="android:textColorPrimary">#000000</item> <!-- Цвет текста -->
        <item name="hintTextColor">#000000</item>
    </style>

    <style name="StyleForWatchLaterButtons" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
    </style>


    <style name="DialogPosterBtn" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
    </style>
</resources>